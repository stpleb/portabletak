<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Speech to text in its own process, started by the plugin for each clip. Whisper's native engine and the
    libraries it needs are kept out of WinTAK: a crash here cannot take WinTAK down, and nothing clashes with
    WinTAK's fixed versions of System.Memory and friends. net8.0 is for tools/run-whisper-test.sh.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget Condition="'$(TargetFramework)' == 'net48'">x64</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
  </ItemGroup>
</Project>
