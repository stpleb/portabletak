<Project Sdk="Microsoft.NET.Sdk">
  <!-- The plugin's voice code on .NET 8, so tools/run-e2e.sh can test it without Windows. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);SYSLIB0026;SYSLIB0027;SYSLIB0057;CS0618;SYSLIB0014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="HistoryTest.cs" />
    <Compile Include="WhisperTest.cs" />
    <Compile Include="..\Voice\*.cs" />
    <PackageReference Include="Concentus" Version="1.1.7" />
  </ItemGroup>
</Project>
