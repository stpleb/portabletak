#!/bin/sh
# PID 1 of the PortableTAK Mac VM (QEMU on Apple Silicon).
# Brings up the VM, starts the dashboard API and the PortableTAK drive (attached
# as the second virtio disk), and a loopback-forwarded control service that
# the Mac launcher uses to stop safely. Never exits (PID 1).
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /run /tmp && mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs -o mode=755 tmpfs /run; mount -t tmpfs -o mode=1777 tmpfs /tmp
mount -o remount,rw / 2>/dev/null
hostname portabletak
for m in virtio_net virtio_blk loop vfat nls_cp437 nls_iso8859_1 ext4 rtc_pl031; do modprobe "$m" 2>/dev/null; done
# Clock: QEMU's RTC (pl031 is a module here); the Mac launcher also passes its time.
hwclock --hctosys --utc 2>/dev/null
T="$(sed -n 's/.*pt\.time=\([0-9]*\).*/\1/p' /proc/cmdline)"
[ -n "$T" ] && [ "$(date +%s)" -lt "$T" ] && date -u -s "@$T" >/dev/null
LOG=/var/log/portabletak-vm.log; mkdir -p /var/log /tmp/portabletak
exec >>"$LOG" 2>&1 </dev/null
echo "== PortableTAK VM boot $(date -u)"
ip link set lo up
NIC="$(ls /sys/class/net | grep -v lo | head -n 1)"
ip link set "$NIC" up
ip addr add 10.0.2.15/24 dev "$NIC"
ip route add default via 10.0.2.2
echo "nameserver 10.0.2.3" > /etc/resolv.conf
# The Mac's own address (phones connect there; QEMU forwards the TAK ports to us).
ADVERTISE="$(sed -n 's/.*pt\.advertise=\([0-9.]*\).*/\1/p' /proc/cmdline)"
mkdir -p /etc/portabletak
{
    echo "PT_PROFILE=linux"
    echo "PT_SERVICE_IP=10.0.2.15"
    echo "PT_SERVICE_DEV=$NIC"
    echo "PT_BOOT_DEV=$NIC"
    [ -n "$ADVERTISE" ] && echo "PT_ADVERTISE_IP=$ADVERTISE"
    # The Mac's own Tailscale address (remote access via the Mac's Tailscale app).
    EXTRA="$(sed -n 's/.*pt\.extra=\([0-9.,]*\).*/\1/p' /proc/cmdline)"
    [ -n "$EXTRA" ] && echo "PT_EXTRA_IPS=$EXTRA"
} > /etc/portabletak/host-profile
PT_API_HOST=0.0.0.0 /usr/local/portabletak/bin/portabletak-wsl-api start   # only reachable via QEMU forwards
/usr/bin/python3 /usr/local/portabletak/bin/portabletak-vm-control &
echo "== autoload"
/usr/local/portabletak/bin/portabletak-autoload > /run/portabletak-autoload.out 2>&1
cat /run/portabletak-autoload.out
while :; do sleep 3600; done
