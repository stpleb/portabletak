#!/usr/bin/python3
"""Control service of the PortableTAK Mac VM (port 8091).

QEMU forwards it only to 127.0.0.1 on the Mac, so only the Mac launcher can
reach it. GET /status -> autoload result + health; POST /stop -> safe remove,
then power off the VM.
"""
from http.server import BaseHTTPRequestHandler, HTTPServer
import os
import subprocess
import threading

BIN = '/usr/local/portabletak/bin/'


def run(command):
    result = subprocess.run(command, capture_output=True, text=True, stdin=subprocess.DEVNULL)
    return result.stdout + result.stderr


class Handler(BaseHTTPRequestHandler):
    def reply(self, text, code=200):
        data = text.encode()
        self.send_response(code)
        self.send_header('Content-Type', 'text/plain')
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == '/log':
            try:
                log = open('/var/log/portabletak-vm.log').read()[-20000:]
            except OSError:
                log = ''
            # PortableTAK's own lines from the server log (no passwords are logged there).
            for name in ('opentakserver.log', 'federation_server.log'):
                try:
                    with open('/mnt/asgard/opentak/data/logs/' + name, errors='replace') as stream:
                        ours = [line for line in stream.read()[-2000000:].splitlines() if 'PortableTAK:' in line]
                    log += '\n--- %s (PortableTAK) ---\n' % name + '\n'.join(ours[-60:]) + '\n'
                except OSError:
                    pass
            # Which enrollment requests the TAK apps made (paths and status codes only).
            import glob
            for access in glob.glob('/mnt/asgard/rootfs/var/log/nginx/access.log') + glob.glob('/mnt/asgard/arch/amd64/rootfs/var/log/nginx/access.log'):
                try:
                    with open(access, errors='replace') as stream:
                        tls = [line.split('"')[1] + ' ' + line.split('"')[2].split()[0]
                               for line in stream.read()[-500000:].splitlines() if '/Marti/api/tls' in line and line.count('"') >= 2]
                    log += '--- nginx (enrollment) ---\n' + '\n'.join(tls[-20:]) + '\n'
                except (OSError, IndexError):
                    pass
            return self.reply('date: ' + run(['date', '-u']) + log)
        if self.path != '/status':
            return self.reply('not found\n', 404)
        autoload = ''
        try:
            autoload = open('/run/portabletak-autoload.out').read()
        except OSError:
            autoload = 'PORTABLETAK_AUTOLOAD=STARTING\n'
        self.reply(autoload + run([BIN + 'portabletak-health']))

    def do_POST(self):
        if self.path == '/stop':
            out = run([BIN + 'portabletak-safe-remove'])
            self.reply(out)
            threading.Timer(2, lambda: (os.sync(), open('/proc/sysrq-trigger', 'w').write('o'))).start()
        elif self.path == '/setup':
            length = int(self.headers.get('Content-Length', '0'))
            body = self.rfile.read(min(length, 16384))
            gate = '/usr/local/portabletak/release/first-run-enabled'
            os.makedirs(os.path.dirname(gate), exist_ok=True)
            open(gate, 'w').close()
            try:
                result = subprocess.run([BIN + 'portabletak-wsl-provision'], input=body, capture_output=True)
            finally:
                os.unlink(gate)
            self.reply(result.stdout.decode() + result.stderr.decode())
        else:
            self.reply('not found\n', 404)

    def log_message(self, *args):
        pass


HTTPServer(('0.0.0.0', 8091), Handler).serve_forever()
