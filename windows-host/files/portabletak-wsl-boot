#!/bin/sh
# Runs when the PortableTAK WSL distribution starts: the dashboard API only.
# The cartridge itself is attached and started by the Windows launcher
# (wsl --mount ... --bare, then portabletak-wsl-start).
mkdir -p /tmp/portabletak /run/portabletak
/usr/local/portabletak/bin/portabletak-wsl-api start >/dev/null 2>&1 &
exit 0
