#!/bin/sh /etc/rc.common

START=96
STOP=10

USE_PROCD=1

# Runs once in the background so a slow cartridge start never holds up boot.
start_service()
{
    logger -t portabletak "checking for PortableTAK cartridge at boot"
    procd_open_instance portabletak-boot
    procd_set_param command /usr/local/portabletak/bin/portabletak-boot
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

# Runs at shutdown/reboot (K10, before networking stops): stop services,
# unmount the cartridge cleanly, and release the service address so the next
# boot finds a clean filesystem and another node can take over the address.
stop_service()
{
    logger -t portabletak "shutdown: stopping PortableTAK and unmounting the cartridge"
    /usr/local/portabletak/bin/portabletak-safe-remove 2>&1 | logger -t portabletak
    /usr/local/portabletak/adapters/openmanet/network release 2>&1 | logger -t portabletak
    sync
}
