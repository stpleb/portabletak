#!/bin/sh /etc/rc.common

START=97
STOP=9

USE_PROCD=1

start_service()
{
    procd_open_instance

    procd_set_param command \
        /usr/bin/python3 \
        -m uvicorn \
        --app-dir /usr/local/portabletak/api \
        app:app \
        --host 127.0.0.1 \
        --port 8090 \
        --proxy-headers \
        --forwarded-allow-ips 127.0.0.1

    procd_set_param env \
        PYTHONPATH=/usr/local/portabletak/python \
        PYTHONUNBUFFERED=1 \
        PORTABLETAK_MANAGEMENT_AUTH=enforce

    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1

    procd_close_instance
}
