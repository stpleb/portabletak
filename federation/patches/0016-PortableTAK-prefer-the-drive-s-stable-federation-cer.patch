From 46e1a88a3fbe820ff473879df1acc994a34dd64b Mon Sep 17 00:00:00 2001
From: pt <pt@local>
Date: Fri, 23 Oct 2026 00:39:08 -0500
Subject: [PATCH 16/16] PortableTAK: prefer the drive's stable federation
 certificate

---
 opentakserver/federation/truststore.py | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/opentakserver/federation/truststore.py b/opentakserver/federation/truststore.py
index 4724cda..a100139 100644
--- a/opentakserver/federation/truststore.py
+++ b/opentakserver/federation/truststore.py
@@ -50,6 +50,16 @@ def _ca_paths(config) -> list[str]:
 
 
 def _server_cert_paths(config) -> tuple[str, str]:
+    # PortableTAK: a dedicated federation certificate (named after the drive, never
+    # reissued when the drive's addresses change) keeps federation pins valid.
+    federation_folder = os.path.join(config.get("OTS_CA_FOLDER"), "certs", "federation")
+    if os.path.isfile(os.path.join(federation_folder, "federation.pem")) and os.path.isfile(
+        os.path.join(federation_folder, "federation.nopass.key")
+    ):
+        return (
+            os.path.join(federation_folder, "federation.pem"),
+            os.path.join(federation_folder, "federation.nopass.key"),
+        )
     cert_folder = os.path.join(config.get("OTS_CA_FOLDER"), "certs", "opentakserver")
     return (
         os.path.join(cert_folder, "opentakserver.pem"),
-- 
