diff --git a/opentakserver/federation/proto/fig.proto b/opentakserver/federation/proto/fig.proto
new file mode 100644
index 0000000..bdfd253
--- /dev/null
+++ b/opentakserver/federation/proto/fig.proto
@@ -0,0 +1,179 @@
+// TAK Server federation wire messages.
+//
+// Vendored from the TAK Product Center's TAK Server source (GPLv3), with the
+// gRPC service definition omitted: federation v1 exchanges these messages as
+// length-prefixed frames over a mutually-authenticated TLS socket and needs
+// no gRPC. Field numbers and types are unchanged, so the wire format is
+// identical to official TAK Server federation.
+// Source: https://github.com/TAK-Product-Center/Server
+//         src/takserver-protobuf/src/main/proto/fig.proto
+
+syntax = "proto3";
+
+import "binarypayload.proto";
+
+option java_multiple_files = true;
+option java_package = "com.atakmap.Tak";
+option java_outer_classname = "FigProto";
+option objc_class_prefix = "TAK";
+
+package com.atakmap;
+
+enum CRUD { INVALID = 0; CREATE = 1; READ = 2; UPDATE = 3; DELETE = 4; }
+enum BINARY_TYPES { EMPTY = 0; OTHER = 1; IMAGE = 2; }
+
+message FederatedEvent {
+	GeoEvent event = 1;
+	ContactListEntry contact = 2;
+	repeated string federateGroups = 3;
+	repeated FederateProvenance federateProvenance = 4;
+	FederateHops federateHops = 5;
+	FederateGroupHopLimits federateGroupHopLimits = 6;
+}
+
+message GeoEvent {
+	 int64 sendTime = 1;
+	 int64 startTime = 2;
+	 int64 staleTime = 3;
+	 double lat = 4;  // WSG-84
+	 double lon = 5;  // WSG-84
+	 double hae = 6;  // meters
+	 double ce = 7;   // meters
+	 double le = 8;   // meters
+	 string uid = 9;  // track-id
+	 string type= 10; // CoT type
+	 string coordSource = 11;  // CoT 'how'
+	string other = 12;  // CoT detail
+	int32 battery = 13;
+	string ploc = 14;
+	string palt = 15;
+	string screenName = 16;  // callsign
+ 	string groupName = 17;
+ 	string groupRole = 18;
+	string phone = 19;
+	double speed = 20;
+	double course = 21;
+	BinaryBlob binary = 22; //image
+	repeated string ptpUids  = 23;
+	repeated string ptpCallsigns = 24;
+	string feedUid = 25;
+	repeated string missionNames = 26;
+	string access = 27;
+	string caveat = 28;
+	string releaseableTo = 29;
+
+	// optional sequence of binary payloads
+	repeated gov.tak.cop.proto.v1.BinaryPayload bloads = 30;
+}
+
+message BinaryBlob {
+	 BINARY_TYPES type = 1;
+	 bytes data = 2;
+	string filename = 3;
+	int64 timestamp = 4;
+	string description = 5;
+	repeated FederateProvenance federateProvenance = 6;
+	FederateHops federateHops = 7;
+	FederateGroupHopLimits federateGroupHopLimits = 8;
+}
+
+message ContactListEntry {
+	 CRUD operation = 1;
+	 string uid = 2;
+	string callsign = 3;
+	string phone = 4;
+	string sip = 5;
+	string directConnect = 6;
+}
+
+message Empty { }
+
+message Identity {
+    enum ConnectionType {
+        FEDERATION_HUB_SERVER = 0;
+        FEDERATION_HUB_CLIENT = 1;
+        FEDERATION_TAK_SERVER = 2;
+        FEDERATION_TAK_CLIENT = 3;
+    }
+	 string name = 1;
+	 string uid = 2;
+	 string description = 3;
+	 ConnectionType type = 4;
+	 string serverId = 5;
+}
+
+message Subscription {
+	Identity identity = 1;
+	string filter = 2;
+    TakServerVersion version = 3;
+}
+
+message ClientHealth {
+    enum ServingStatus {
+        UNKNOWN = 0;
+        SERVING = 1;
+        NOT_SERVING = 2;
+    }
+    ServingStatus status = 1;
+}
+
+message ServerHealth {
+    enum ServingStatus {
+        UNKNOWN = 0;
+        SERVING = 1;
+        NOT_SERVING = 2;
+        NOT_CONNECTED = 3;
+    }
+    ServingStatus status = 1;
+}
+
+message ROL {
+    string program = 1;
+    repeated BinaryBlob payload = 2;
+	repeated string federateGroups = 3;
+	repeated FederateProvenance federateProvenance = 4;
+	FederateHops federateHops = 5;
+	FederateGroupHopLimits federateGroupHopLimits = 6;
+}
+
+message FederateGroups {
+    ServerHealth streamUpdate = 1;
+	repeated string federateGroups = 2;
+	repeated FederateProvenance federateProvenance = 3;
+	FederateHops federateHops = 4;
+	repeated FederateGroups nestedGroups = 5;
+	FederateGroupHopLimits federateGroupHopLimits = 6;
+}
+
+message TakServerVersion {
+    int64 major = 1; // major version number
+    int64 minor = 2; // minor version number
+    int64 patch = 3; // patch version number
+    string branch = 4; // branch name
+    string variant = 5; // variant name
+}
+
+message FederateProvenance {
+	string federationServerId = 1;
+	string federationServerName = 2;
+}
+
+message FederateHops {
+	int64 maxHops = 1;
+	int64 currentHops = 2;
+}
+
+message FederateGroupHopLimit {
+	string groupName = 1;
+	int64 maxHops = 2;
+	int64 currentHops = 3;
+}
+
+message FederateGroupHopLimits {
+	repeated FederateGroupHopLimit limits = 1;
+	bool useFederateGroupHopLimits = 2;
+}
+
+message FederateTokenResponse {
+	string token = 1;
+}
