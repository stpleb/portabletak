+
         self.bridge.publish_inbound(
             {
-                "uid": fed_event.event.uid,
+                "uid": sender_uid or fed_event.event.uid,
                 "cot": cot,
                 "user_id": None,
                 "groups": inbound_groups,
-                "federate": self.federate["name"],
+                "federate": name,
             }
         )
         self.events_in += 1
