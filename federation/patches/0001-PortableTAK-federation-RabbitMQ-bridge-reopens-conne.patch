index 0000000..91a96c6
--- /dev/null
+++ b/tests/test_portabletak_bridge.py
@@ -0,0 +1,103 @@
+"""PortableTAK: the federation RabbitMQ bridge survives the broker closing its connections.
+
+An idle publisher connection is closed by RabbitMQ after missed heartbeats. The
+next inbound federated event used to fail and take the whole federation link
+down; the bridge now reopens the connection and delivers the event.
+"""
+import logging
+
+import pika.exceptions
+import pytest
+
+from opentakserver.federation import engine
+
+
+class FakeChannel:
+    def __init__(self, conn):
+        self.conn = conn
+
+    def basic_publish(self, **kwargs):
+        if self.conn.dead:
+            raise pika.exceptions.StreamLostError("Stream connection lost: ConnectionResetError(104)")
+        self.conn.published.append(kwargs["body"])
+
+    def exchange_declare(self, *args, **kwargs):
+        pass
+
+    def queue_declare(self, *args, **kwargs):
+        class Result:
+            class method:
+                queue = "q"
+        return Result
+
+    def queue_bind(self, *args, **kwargs):
+        pass
+
+    def basic_consume(self, **kwargs):
+        self.conn.on_message = kwargs["on_message_callback"]
+
+    def start_consuming(self):
+        if self.conn.fail_consume:
+            self.conn.fail_consume = False
+            raise pika.exceptions.StreamLostError("lost")
+        self.conn.on_message(None, None, None, b"event")
+
+
+class FakeConnection:
+    opened = []
+
+    def __init__(self, params):
+        self.dead = False
+        self.is_closed = False
+        self.published = []
+        self.fail_consume = False
+        FakeConnection.opened.append(self)
+
+    def channel(self):
+        return FakeChannel(self)
+
+    def add_callback_threadsafe(self, fn):
+        pass
+
+    def close(self):
+        self.is_closed = True
+
+
+@pytest.fixture
+def bridge(monkeypatch):
+    FakeConnection.opened = []
+    monkeypatch.setattr(engine.pika, "BlockingConnection", FakeConnection)
+    monkeypatch.setattr(engine.time, "sleep", lambda s: None)
+    return engine.RabbitBridge({"OTS_RABBITMQ_SERVER_ADDRESS": "127.0.0.1"}, logging.getLogger("test"))
+
+
+def test_publish_reopens_a_connection_the_broker_closed(bridge):
+    publisher = FakeConnection.opened[0]
+    bridge.publish_inbound({"uid": "a"})
+    publisher.dead = True                    # broker dropped the idle connection
+    bridge.publish_inbound({"uid": "b"})     # must not raise
+    fresh = FakeConnection.opened[-1]
+    assert fresh is not publisher
+    assert len(publisher.published) == 1 and len(fresh.published) == 1
+
+
+def test_publish_gives_up_after_one_retry(bridge, monkeypatch):
+    FakeConnection.opened[0].dead = True
+
+    class AlwaysDead(FakeConnection):
+        def __init__(self, params):
+            super().__init__(params)
+            self.dead = True
+
+    monkeypatch.setattr(engine.pika, "BlockingConnection", AlwaysDead)
+    with pytest.raises(pika.exceptions.AMQPError):
+        bridge.publish_inbound({"uid": "c"})
+
+
+def test_consumer_reopens_after_losing_its_connection(bridge):
+    consumer = FakeConnection.opened[1]
+    consumer.fail_consume = True
+    received = []
+    bridge.consume_outbound(received.append)
+    assert received == [b"event"]
+    assert FakeConnection.opened[-1] is not consumer
